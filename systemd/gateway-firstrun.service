[Unit]
Description=BitTug First-Run Provisioning
ConditionPathExists=!/etc/gateway-provisioned
Documentation=https://github.com/bitcryptic-gw/bittug
After=network-online.target
Requires=network-online.target
# Ordering only (no Requires=) on time-sync.target. systemd-time-wait-sync.service
# is bounded by a TimeoutStartSec=90s drop-in and may legitimately fail on an
# offline boot; a hard Requires= would not propagate that failure anyway (the
# vendor unit only Wants=/Before= the target), and the authoritative guard
# against a stale clock is the git-clone retry loop in firstrun.sh.
After=time-sync.target

[Service]
Type=oneshot
ExecStart=/boot/firmware/firstrun.sh
# Generous: firstrun deliberately waits for a real link (up to ~6 min) before
# provisioning, so the unit budget must exceed that plus clone/bootstrap.
TimeoutStartSec=1200
# journal+console: on a failed fresh boot SSH may be closed and console input
# dead, leaving the HDMI console as the only observable channel. Mirror the
# provisioning output there so a failure is visible on screen.
StandardOutput=journal+console
StandardError=journal+console
SyslogIdentifier=gateway-firstrun
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

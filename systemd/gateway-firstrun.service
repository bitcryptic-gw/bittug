[Unit]
Description=BitTug First-Run Provisioning
ConditionPathExists=!/etc/gateway-provisioned
Documentation=https://github.com/bitcryptic-gw/bittug
After=network-online.target
Requires=network-online.target
After=time-sync.target
Requires=time-sync.target

[Service]
Type=oneshot
ExecStart=/boot/firmware/firstrun.sh
TimeoutStartSec=600
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gateway-firstrun
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

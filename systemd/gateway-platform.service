[Unit]
Description=BitTug Platform Init
Documentation=https://github.com/bitcryptic-gw/bittug

# Readiness ordering — mirror gateway-firstrun.service.
#
# time-sync.target: ordered After= the target, deliberately NOT Requires=.
# systemd-time-wait-sync.service is bounded by a TimeoutStartSec=90s drop-in and
# may legitimately fail on an offline boot; a hard Requires= would not even
# propagate that failure (the vendor unit only Wants=/Before= the target). The
# authority on "is the clock usable" is the connectivity pre-check + retry in
# first-boot.sh, not the target's clean success.
#
# network-online.target: kept as Requires= so the unit is not started at all
# until systemd considers the network online. Trade-off, stated rather than
# silently chosen: on a device that never reaches network-online this unit will
# be left unstarted/failed instead of starting and partly provisioning. This
# whole script is internet-dependent. The wait is bounded by the wait-online
# service timeout, not indefinite. The script's own connectivity pre-check +
# retry is the authoritative guard; this ordering merely avoids wasted attempts.
#
# docker.service: ordering only (After=, no Wants/Requires). On a fresh device
# Docker does not exist yet — it is installed BY this script — so pulling it in
# here would be wrong.
After=network-online.target time-sync.target docker.service
Requires=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/gateway/scripts/first-boot.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gateway-platform

[Install]
WantedBy=multi-user.target

[Unit]
Description=DePIN — MastChain (AIS-catcher)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
# Bound the restart loop on a permanent failure (e.g. dongle pulled, or dongle
# held busy by readsb): give up after 5 failures in 300s instead of retrying
# forever. Upstream's mastradar.service had no limits and crash-looped to failed.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=/etc/gateway-ui/depin/mastchain.env
# Skip this unit entirely when no RTL-SDR-class device is present — e.g. a device
# not (yet) running the MastChain AIS module. exit 77 = skipped, not failed, and
# a skipped start does not count toward StartLimitBurst. Presence-only: a dongle
# that is present but busy (held by readsb) still fails at container open and is
# bounded by StartLimitIntervalSec/Burst above.
ExecCondition=/opt/gateway/scripts/mastchain-hardware-check.sh
ExecStartPre=-/usr/bin/docker rm -f mastchain
ExecStart=/usr/bin/docker run \
  --name mastchain \
  --restart no \
  --network bridge \
  --memory=128m \
  --cpus=0.5 \
  --user 65534:65534 \
  --device /dev/bus/usb:/dev/bus/usb \
  ghcr.io/c-man-the-man/mastchain-ais:latest \
  -H https://api.mastchain.io/api/upload \
  USERPWD ${DEPIN_MASTCHAIN_EMAIL}:${DEPIN_MASTCHAIN_TOKEN} \
  INTERVAL 60 \
  -v 60
ExecStartPost=/opt/gateway/scripts/depin-version-boot.sh mastchain
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=depin-mastchain

[Install]
WantedBy=multi-user.target

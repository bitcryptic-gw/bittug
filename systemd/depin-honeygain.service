[Unit]
Description=DePIN — Honeygain
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/gateway-ui/depin/honeygain.env
ExecStartPre=-/usr/bin/docker rm -f honeygain
ExecStart=/usr/bin/docker run \
  --name honeygain \
  --restart no \
  --network bridge \
  --memory=128m \
  --cpus=0.5 \
  honeygain/honeygain:latest \
  -tou-accept \
  -device ${DEPIN_DEVICE_NAME} \
  -email ${DEPIN_HONEYGAIN_EMAIL} \
  -pass ${DEPIN_HONEYGAIN_PASSWORD}
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=depin-honeygain

[Install]
WantedBy=multi-user.target

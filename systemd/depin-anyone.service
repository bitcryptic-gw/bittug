[Unit]
Description=DePIN — Anyone Protocol
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=-/usr/bin/docker rm -f anyone
ExecStartPre=-/opt/gateway/scripts/depin-anyone-uid-check.sh
ExecStart=/usr/bin/docker run \
  --name anyone \
  --restart no \
  --network bridge \
  --memory=512m \
  --cpus=1.0 \
  -p 9001:9001/tcp \
  -p 9030:9030/tcp \
  -v /var/lib/gateway-ui/anyone/etc:/etc/anon \
  -v /var/lib/gateway-ui/anyone/var:/var/lib/anon \
  -v /var/lib/gateway-ui/anyone/run:/run/anon \
  ghcr.io/anyone-protocol/ator-protocol:latest \
  anon -f /etc/anon/anonrc
ExecStartPost=/opt/gateway/scripts/depin-version-boot.sh anyone
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=depin-anyone

[Install]
WantedBy=multi-user.target
